# Standalone security console.
# The console requires the writable REST pair. The read-only token and TCP URLs
# are optional provider-generated aliases and are not used for auth/session writes.
ADMIN_SECURITY_KV_REST_API_URL=
ADMIN_SECURITY_KV_REST_API_TOKEN=
ADMIN_SECURITY_KV_REST_API_READ_ONLY_TOKEN=
ADMIN_SECURITY_KV_URL=
ADMIN_SECURITY_REDIS_URL=
SECURITY_WEBAUTHN_ORIGIN=https://YOUR-CONSOLE-HOST
SECURITY_WEBAUTHN_RP_ID=YOUR-CONSOLE-HOST
SECURITY_BOOTSTRAP_TOKEN=
# Optional one-time passkey recovery: JSON with sha256 and expiresAt (Unix milliseconds).
# Disabled when empty. See docs/security-console-passkey-recovery.md.
SECURITY_PASSKEY_RECOVERY=
# Axiom legacy dataset query endpoint and a query-only dataset-scoped API token.
SECURITY_LOG_QUERY_URL=https://api.axiom.co/v1/datasets/YOUR_DATASET/query
SECURITY_LOG_QUERY_TOKEN=
# Primary app's protected delivery-test endpoint.
SECURITY_TEST_TARGET_URL=https://www.speedzonems.com/api/internal/security-log-test
# Primary website origin used only for signed, server-side operational-data reads.
SPEEDZONE_SOURCE_URL=https://www.speedzonems.com
# Optional distinct console-network correlation key; set it explicitly (do not reuse the site SECURITY_IP_HASH_SECRET).
SECURITY_CONSOLE_IP_HASH_SECRET=

# Shared with the primary site (same value in both projects).
SECURITY_CONSOLE_SERVICE_SECRET=
SECURITY_CONSOLE_TEST_SECRET=
SECURITY_LOG_PROVIDER=axiom
