{
  "name": "speedzone-motorsports",
  "version": "2.0.0",
  "private": true,
  "description": "Public SpeedZone Motorsports website.",
  "scripts": {
    "dev": "next dev --hostname localhost --port 4173",
    "build": "next build",
    "check:deps": "node scripts/check-deps.js",
    "prebuild": "npm run check:deps && npm run check:security-config",
    "postinstall": "node scripts/patch-tar.cjs && node scripts/patch-toml.cjs && node scripts/patch-yaml.cjs && node scripts/patch-glob.cjs",
    "start": "next start --hostname localhost --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:security-console": "vitest run --config tests/security-console.integration.config.mts && python scripts/verify-security-session-lua.py",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vercel": "vercel",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:security-config": "node scripts/check-security-config.mjs",
    "migrate:inventory": "node scripts/migrate-inventory.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "tar": "^7.5.11",
    "smol-toml": "^1.9.0",
    "js-yaml": "$js-yaml",
    "minimatch@>=3 <4": "^3.1.5",
    "minimatch@>=10 <11": "^10.2.6",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "undici@>=5 <6": "^6.29.0",
    "undici@>=6 <7": "^6.28.1",
    "@fastify/busboy": "^3.2.2"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.44.0",
    "botid": "^1.5.11",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "js-yaml": "^5.4.3",
    "typescript": "5.9.3",
    "vercel": "^59.16.0",
    "vitest": "4.1.11"
  }
}
