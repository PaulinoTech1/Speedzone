{
  "name": "speedzone-motorsports",
  "version": "2.0.0",
  "private": true,
  "description": "Public SpeedZone Motorsports website.",
  "scripts": {
    "dev": "next dev --hostname localhost --port 4173",
    "build": "next build",
    "check:deps": "node scripts/check-deps.js",
    "prebuild": "npm run check:deps",
    "postinstall": "node scripts/patch-tar.cjs && node scripts/patch-toml.cjs && node scripts/patch-yaml.cjs && node scripts/patch-glob.cjs",
    "start": "next start --hostname localhost --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:security-console": "vitest run --config tests/security-console.integration.config.mts && python scripts/verify-security-session-lua.py",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vercel": "vercel",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "tar": "^7.5.11",
    "smol-toml": "^1.7.1",
    "js-yaml": "$js-yaml",
    "minimatch@>=3 <4": "^3.1.5",
    "minimatch@>=10 <11": "^10.2.6"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.44.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "js-yaml": "^4.3.2",
    "typescript": "7.0.2",
    "vercel": "^59.16.0",
    "vitest": "4.1.11"
  }
}
