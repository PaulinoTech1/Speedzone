{
  "name": "speedzone-motorsports",
  "version": "2.0.0",
  "private": true,
  "description": "Public SpeedZone Motorsports website.",
  "scripts": {
    "dev": "next dev --hostname localhost --port 4173",
    "build": "next build",
    "start": "next start --hostname localhost --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
