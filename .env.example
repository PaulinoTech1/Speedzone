ADMIN_ID=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_PEPPER=
ADMIN_BOOTSTRAP_TOKEN_HASH=
ADMIN_DISABLED=
AUTH_COOKIE_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_EXPECTED_ORIGIN=
# Authoritative server-side authentication storage: the SEcure_Auth database in
# Neon project shy-sunset-14721124. Required in production. Apply the schema with
# `npm run migrate:auth-db` before the first deployment.
AUTH_DATABASE_URL=
# Optional override of the database name the connection string must point at.
# Defaults to SEcure_Auth; leave unset unless the database was renamed.
AUTH_DATABASE_NAME=
# Legacy read-only source for the one-time Global Config to Blob migration.
INVENTORY_GLOBAL_CONFIG=
# Legacy read-only source for the one-time auth migration into SEcure_Auth.
AUTH_GLOBAL_CONFIG=
# Connect the private speedzone-blbob store with the BLOB_INVENTORY prefix.
BLOB_INVENTORY_READ_WRITE_TOKEN=
BLOB_INVENTORY_STORE_ID=
# Default-prefix fallback when speedzone-blbob is the project's default Blob store.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Separate private audit/staging and public-photo stores.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PHOTO_READ_WRITE_TOKEN=
ENABLE_ENCRYPTED_LOCAL_DRAFTS=
ENABLE_ARGON2_BENCHMARK=
MAX_IMAGE_DIMENSION=
MAX_IMAGE_BYTES=
LOCAL_STATE_PATH=
LOCAL_SECURITY_PATH=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
