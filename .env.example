ADMIN_ID=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_PEPPER=
ADMIN_BOOTSTRAP_TOKEN_HASH=
ADMIN_DISABLED=
AUTH_COOKIE_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_EXPECTED_ORIGIN=
# Authoritative server-side authentication storage: the SEcure_Auth database in
# Neon project shy-sunset-14721124. Required in production. Apply the schema with
# `npm run migrate:auth-db -- --grant-role <runtime-role>` before deploying,
# including existing deployments adopting shared rate limits (db/003).
AUTH_DATABASE_URL=
# Optional override of the database name the connection string must point at.
# Defaults to SEcure_Auth; leave unset unless the database was renamed.
AUTH_DATABASE_NAME=
# Legacy read-only source for the one-time auth migration into SEcure_Auth.
AUTH_GLOBAL_CONFIG=
# Legacy read-only source for the one-time auth migration off private Blob.
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Private Vercel Blob token for test-drive lead records.
Test_Drive=
Test_Drive_STORE_ID=store_8wyMMbqPZkpgwRwg
# Vehicle inventory and photo storage. Vercel's Sanity integration supplies
# the NEXT_PUBLIC identifiers and SANITY_API_WRITE_TOKEN aliases. The public
# values are identifiers, not secrets; the token must remain server-only.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
# Supported Vercel Sanity integration aliases. If both forms of a value are
# configured they must match. Set one token form, not two different tokens.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_WRITE_TOKEN=
# Optional: pinned dated API version. Defaults to a known-stable past date.
SANITY_API_VERSION=
ENABLE_ENCRYPTED_LOCAL_DRAFTS=
ENABLE_ARGON2_BENCHMARK=
MAX_IMAGE_DIMENSION=
MAX_IMAGE_BYTES=
LOCAL_STATE_PATH=
LOCAL_SECURITY_PATH=
# Test-drive email stays disabled unless all three values are supplied.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
