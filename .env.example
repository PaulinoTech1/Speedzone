# Required for encrypted test-drive submissions: a random 32-byte Base64URL value (43 characters).
TEST_DRIVE_ENCRYPTION_KEY=

# Bootstrap-only admin credential; replaced by the Argon2id Redis credential after first login.
SPEEDZONE_ADMIN_PASSWORD=

# Canonical public Blob origin for inventory photos; required for uploads and photo mutations.
INVENTORY_BLOB_ORIGIN=https://your-store.public.blob.vercel-storage.com

# Best-effort structured security logging for the main website.
SECURITY_LOG_PROVIDER=disabled
SECURITY_LOG_INGEST_URL=
SECURITY_LOG_INGEST_TOKEN=

# Independent security-console deployment. Never reuse inventory Redis/session keys.
SECURITY_KV_REST_API_URL=
SECURITY_KV_REST_API_TOKEN=
SECURITY_WEBAUTHN_ORIGIN=
SECURITY_WEBAUTHN_RP_ID=
SECURITY_BOOTSTRAP_TOKEN=
SECURITY_LOG_PROVIDER_URL=
SECURITY_LOG_PROVIDER_TOKEN=

# External operations: configure Vercel Drain/Axiom, immutable object storage, KMS key retention,
# DNS, and alerting separately. Application code does not provision or claim those controls.
# The public website requires no other application secrets or service credentials.
