# Public inventory Blob store (separate from private customer data)
BLOB_READ_WRITE_TOKEN=
# The token store ID is authoritative; these are legacy/configuration fallbacks.
INVENTORY_BLOB_ORIGIN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Dedicated PRIVATE Blob store, required by both submission writer and inbox reader
TEST_DRIVE_BLOB_READ_WRITE_TOKEN=
# Random 32-byte Base64URL key. Back up securely; changing it breaks existing record decryption.
TEST_DRIVE_ENCRYPTION_KEY=
# Shared Redis for auth and limiting. Use a separate instance for previews.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatively set the complete UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN pair.
SPEEDZONE_ADMIN_PASSWORD=
WEBAUTHN_ORIGIN=https://www.speedzonems.com
WEBAUTHN_RP_ID=www.speedzonems.com
# Verify these mailboxes with the business owner before deployment.
TEST_DRIVE_NOTIFICATION_EMAIL=
ADMIN_RECOVERY_EMAIL=
RESEND_API_KEY=
RESEND_PASSWORD_RESET_API_KEY=
RESEND_EMAIL_DOMAIN=
# Optional best-effort event delivery. No customer form contents.
SECURITY_LOG_PROVIDER=disabled
SECURITY_LOG_INGEST_URL=
SECURITY_LOG_INGEST_TOKEN=
# Public footer destination. Change to https://logs.speedzonems.com at rollout.
NEXT_PUBLIC_SECURITY_CONSOLE_URL=https://speedzone-security-console-preview.vercel.app
# Shared HMAC secret used only by the primary app and security-console delivery test.
SECURITY_CONSOLE_TEST_SECRET=
# Shared HMAC secret for the console's read-only operational-data requests.
# Generate one 32-byte Base64URL value and set the same value in both projects.
SECURITY_CONSOLE_SERVICE_SECRET=
# HMAC key used to correlate administrator networks without storing raw IP addresses.
SECURITY_IP_HASH_SECRET=

# Private bug reports: fail closed until configured. Keep Preview separate.
BUG_REPORT_ORIGIN=https://www.speedzonems.com
# Independent random 32-byte Base64URL encryption key (43 characters).
BUG_REPORT_ENCRYPTION_KEY=
# Independent random secret, at least 32 characters, for keyed rate-limit identifiers.
BUG_REPORT_RATE_LIMIT_SECRET=

# Separate security-console project. Use Preview-only values until rollout.
# The console requires the writable REST pair. The read-only token and TCP URLs
# are optional provider-generated aliases and are not used for auth/session writes.
ADMIN_SECURITY_KV_REST_API_URL=
ADMIN_SECURITY_KV_REST_API_TOKEN=
ADMIN_SECURITY_KV_REST_API_READ_ONLY_TOKEN=
ADMIN_SECURITY_KV_URL=
ADMIN_SECURITY_REDIS_URL=
SECURITY_WEBAUTHN_ORIGIN=https://logs.speedzonems.com
SECURITY_WEBAUTHN_RP_ID=logs.speedzonems.com
SECURITY_BOOTSTRAP_TOKEN=
# Axiom legacy dataset query endpoint and a query-only dataset-scoped API token.
SECURITY_LOG_QUERY_URL=https://api.axiom.co/v1/datasets/YOUR_DATASET/query
SECURITY_LOG_QUERY_TOKEN=
# Primary app's protected delivery-test endpoint.
SECURITY_TEST_TARGET_URL=https://www.speedzonems.com/api/internal/security-log-test
# Primary website origin used only for signed, server-side operational-data reads.
SPEEDZONE_SOURCE_URL=https://www.speedzonems.com
# Optional distinct console-network correlation key; falls back to SECURITY_IP_HASH_SECRET.
SECURITY_CONSOLE_IP_HASH_SECRET=
